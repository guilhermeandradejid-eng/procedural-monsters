; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Emberquill"
config/description="Roguelite de ação co-op local onde cada feitiço é uma frase escrita num grimório."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Devices="*res://scripts/autoload/devices.gd"
Audio="*res://scripts/autoload/audio.gd"
Juice="*res://scripts/autoload/juice.gd"
Fx="*res://scripts/autoload/fx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.pt_BR.translation")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.05, 1)
textures/canvas_textures/default_texture_filter=1
